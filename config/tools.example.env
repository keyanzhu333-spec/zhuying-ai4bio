# Copy only the lines you need into your shell profile or a private env file.
# Do not commit real API keys, credentials, or machine-specific private paths.

# Optional executable overrides. Commands already available on PATH need no entry.
# export GMX_BIN="/path/to/gmx"
# export GNINA_BIN="/path/to/gnina"
# export UNIDOCK_PRO_BIN="/path/to/udp"
# export OBABEL_BIN="/path/to/obabel"
# export LIGHTDOCK_SETUP_BIN="/path/to/lightdock3_setup.py"
# export HADDOCK3_BIN="/path/to/haddock3"
# export CHAI1_BIN="/path/to/chai-lab"
# export PLIP_BIN="/path/to/plip"

# Optional shared data root for screening libraries, model weights, and caches.
# Keep large data outside Git and describe each resource in resources.example.json.
# export ZY_AI4BIO_DATA="$HOME/zy-ai4bio-data"

# DiffDock authentication belongs in the user's environment or private credential
# store. Never place the real value in this repository.
# export NVIDIA_API_KEY="nvapi-your-own-key"
