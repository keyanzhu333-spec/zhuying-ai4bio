; Generic unrestrained production starting point. Validate before a long run.
integrator              = md
dt                      = 0.002
nsteps                  = ${production_steps}
continuation            = yes
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-iter              = 1
lincs-order             = 4
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
pbc                     = xyz
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = ${temperature}
pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau-p                   = 5.0
ref-p                   = ${pressure}
compressibility         = 4.5e-5
gen-vel                 = no
nstcalcenergy           = 100
nstenergy               = 5000
nstlog                  = 5000
nstxout-compressed      = 5000
compressed-x-precision  = 1000
